{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GyroX-Space/cyclemark-btc/blob/main/data/signals/schema.json",
  "title": "CycleMark Daily Record",
  "type": "object",
  "required": ["schema_version", "date", "generated_at_utc", "model_version", "status", "state", "bfs", "bos", "scores_are_validated", "market_data", "sources", "notes"],
  "properties": {
    "schema_version": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "model_version": {"type": "string"},
    "status": {"type": "string"},
    "state": {"type": ["string", "null"], "enum": ["risk", "watch", "forming", "opportunity", null]},
    "bfs": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "bos": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "scores_are_validated": {"type": "boolean"},
    "market_data": {"type": "object"},
    "sources": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
